generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────── Enums ─────────
enum Role {
  OWNER
  ADMIN
  MEMBER
}
enum JobStatus {
  PENDING
  PROCESSING
  DONE
  ERROR
}
enum AutomationMode {
  MANUAL
  SEMI_AUTO
}
enum LeadStatus {
  FOUND
  ANALYZED
  MESSAGE_READY
  CONTACTED
  REPLIED
  INTERESTED
  MEETING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  DISCARDED
}
enum InteractionType {
  NOTE
  CALL
  WHATSAPP
  EMAIL
  MEETING
  SYSTEM
}
enum MessageStage {
  FIRST_CONTACT
  SECOND_CONTACT
  FOLLOW_UP
  PRESENTATION
  PROPOSAL
  RECOVERY
  AFTER_SALE
}
enum MessageStatus {
  DRAFT
  APPROVED
  SENT
  FAILED
}
enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}
enum ProjectStatus {
  WAITING_CLIENT
  IN_PROGRESS
  REVIEW
  DONE
  CANCELED
}
enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}
enum NotificationType {
  NEW_LEAD
  LEAD_QUALIFIED
  REPLY
  FOLLOW_UP
  PROPOSAL_ACCEPTED
  PAYMENT
  PAYMENT_OVERDUE
  PROJECT_DEADLINE
  PROJECT_LATE
  AUTOMATION_FAILED
  INTEGRATION_FAILED
  SECURITY
  SYSTEM
}
enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

// ───────── Identidade & segurança ─────────
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  passwordHash     String
  role             Role      @default(OWNER)
  active           Boolean   @default(true)
  mfaEnabled       Boolean   @default(false)
  mfaSecretEnc     String? // AES-256-GCM
  mfaRecoveryHashes String[] // hashes de códigos de recuperação
  lastLoginAt      DateTime?
  lastLoginIp      String?
  passwordChangedAt DateTime @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  sessions     Session[]
  resetTokens  PasswordResetToken[]
  auditLogs    AuditLog[]
  notifications Notification[]
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique // SHA-256 do token; o token nunca é salvo
  csrfSecret   String
  mfaVerified  Boolean   @default(false)
  ip           String?
  userAgent    String?
  device       String?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipHash    String
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    String // ex.: auth.login, client.create
  entity    String?
  entityId  String?
  result    AuditResult @default(SUCCESS)
  ip        String?
  userAgent String?
  meta      Json? // nunca incluir segredos/PII desnecessária
  category  String      @default("general") // general | security | finance
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([entity, entityId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Integration {
  id          String   @id @default(cuid())
  provider    String   @unique // google_places, whatsapp_cloud, llm, smtp, s3
  enabled     Boolean  @default(false)
  status      String   @default("AGUARDANDO_INTEGRACAO")
  lastError   String?
  config      Json? // somente dados não sensíveis
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  credentials ApiCredential[]
}

model ApiCredential {
  id            String      @id @default(cuid())
  integrationId String
  label         String
  secretEnc     String // AES-256-GCM
  lastFour      String?
  rotatedAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
}

model BackupRecord {
  id         String    @id @default(cuid())
  status     JobStatus @default(PENDING)
  location   String?
  sizeBytes  BigInt?
  sha256     String?
  verifiedAt DateTime? // teste de restauração/integridade
  error      String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
}

model Job {
  id         String    @id @default(cuid())
  type       String // lead_search, ai_analysis, report, backup, automation...
  status     JobStatus @default(PENDING)
  payload    Json?
  result     Json?
  error      String?
  attempts   Int       @default(0)
  runAt      DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, runAt])
  @@index([type, createdAt])
}

// ───────── Comercial / CRM ─────────
model Niche {
  id        String            @id @default(cuid())
  name      String            @unique
  active    Boolean           @default(true)
  templates MessageTemplate[]
  leads     Lead[]
  createdAt DateTime          @default(now())
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#64748b")
  leads Lead[]
  clients Client[]
}

model Company {
  id        String    @id @default(cuid())
  name      String
  tradeName String?
  website   String?
  phone     String?
  email     String?
  city      String?
  state     String?
  address   String?
  instagram String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  contacts  Contact[]
  leads     Lead[]
  clients   Client[]

  @@index([name])
}

model Contact {
  id        String    @id @default(cuid())
  companyId String?
  name      String
  role      String?
  phone     String?
  whatsapp  String?
  email     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

model Lead {
  id             String     @id @default(cuid())
  companyId      String?
  nicheId        String?
  name           String
  tradeName      String?
  category       String?
  subniche       String?
  city           String?
  state          String?
  address        String?
  phone          String?
  phoneNorm      String? // somente dígitos, p/ deduplicação
  email          String?
  website        String?
  websiteHost    String? // host normalizado, p/ deduplicação
  instagram      String?
  socials        Json?
  rating         Float?
  reviewCount    Int?
  dedupeKey      String? // nome+endereço normalizados
  status         LeadStatus @default(FOUND)
  score          Int?
  analysis       Json? // presença digital, oportunidade, produto sugerido (base: dados reais)
  opportunity    String?
  suggestedProduct String?
  nextAction     String?
  nextActionAt   DateTime?
  followUpAt     DateTime?
  notes          String?
  collectedAt    DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  company        Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  niche          Niche?     @relation(fields: [nicheId], references: [id], onDelete: SetNull)
  sources        LeadSource[]
  tags           Tag[]
  interactions   Interaction[]
  messages       Message[]
  opportunities  Opportunity[]
  client         Client?

  @@index([status, deletedAt])
  @@index([phoneNorm])
  @@index([websiteHost])
  @@index([dedupeKey])
  @@index([followUpAt])
  @@index([city, nicheId])
}

model LeadSource {
  id         String   @id @default(cuid())
  leadId     String
  provider   String // google_places, manual, csv...
  externalId String?
  rawRef     Json?
  collectedAt DateTime @default(now())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([leadId])
}

model LeadScoreRule {
  id        String  @id @default(cuid())
  criterion String  @unique // has_phone, has_whatsapp, has_instagram, no_website...
  label     String
  weight    Int     @default(1)
  points    Int     @default(10)
  active    Boolean @default(true)
}

// Configurações → Regras comerciais (detector de oportunidades)
model BusinessRule {
  id        String  @id @default(cuid())
  name      String
  condition Json // ex.: {"field":"website","op":"missing"}
  opportunity String
  suggestedService String?
  priority  Int     @default(0)
  active    Boolean @default(true)
}

model Interaction {
  id        String          @id @default(cuid())
  leadId    String?
  clientId  String?
  type      InteractionType
  summary   String
  aiGenerated Boolean       @default(false)
  createdAt DateTime        @default(now())
  lead      Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client    Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([clientId, createdAt])
}

model MessageTemplate {
  id        String       @id @default(cuid())
  nicheId   String?
  stage     MessageStage
  name      String
  body      String // aceita {{empresa}}, {{cidade}}...
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  niche     Niche?       @relation(fields: [nicheId], references: [id], onDelete: SetNull)
  messages  Message[]

  @@index([nicheId, stage])
}

model Message {
  id          String         @id @default(cuid())
  leadId      String
  templateId  String?
  channel     String         @default("whatsapp")
  body        String
  status      MessageStatus  @default(DRAFT)
  aiGenerated Boolean        @default(false)
  approvedAt  DateTime?
  sentAt      DateTime?
  error       String?
  createdAt   DateTime       @default(now())
  lead        Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  template    MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([status])
}

model Pipeline {
  id     String          @id @default(cuid())
  name   String          @unique
  stages PipelineStage[]
}

model PipelineStage {
  id         String        @id @default(cuid())
  pipelineId String
  name       String
  position   Int
  leadStatus LeadStatus?
  pipeline   Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, position])
}

model Opportunity {
  id        String    @id @default(cuid())
  leadId    String
  title     String
  serviceId String?
  value     Decimal?  @db.Decimal(12, 2)
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  service   Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([leadId])
}

// ───────── Clientes, vendas, projetos ─────────
model Client {
  id        String    @id @default(cuid())
  leadId    String?   @unique
  companyId String?
  name      String
  contactName String?
  phone     String?
  whatsapp  String?
  email     String?
  city      String?
  nicheId   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  tags      Tag[]
  proposals Proposal[]
  projects  Project[]
  payments  Payment[]
  subscriptions Subscription[]
  interactions Interaction[]
  documents Document[]

  @@index([name])
}

model Service {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  price       Decimal  @db.Decimal(12, 2)
  cost        Decimal  @default(0) @db.Decimal(12, 2)
  deadlineDays Int?
  features    String[]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  extras      ServiceExtra[]
  proposalItems ProposalItem[]
  opportunities Opportunity[]
  templates   ProjectTemplate[]
}

model ServiceExtra {
  id        String  @id @default(cuid())
  serviceId String
  name      String
  price     Decimal @db.Decimal(12, 2)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model Proposal {
  id          String         @id @default(cuid())
  clientId    String
  status      ProposalStatus @default(DRAFT)
  deadlineDays Int?
  discount    Decimal        @default(0) @db.Decimal(12, 2)
  total       Decimal        @db.Decimal(12, 2)
  paymentTerms String?
  validUntil  DateTime?
  sentAt      DateTime?
  respondedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  client      Client         @relation(fields: [clientId], references: [id])
  items       ProposalItem[]
  project     Project?

  @@index([clientId, status])
}

model ProposalItem {
  id         String   @id @default(cuid())
  proposalId String
  serviceId  String?
  description String
  quantity   Int      @default(1)
  unitPrice  Decimal  @db.Decimal(12, 2)
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  service    Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([proposalId])
}

model ProjectTemplate {
  id        String   @id @default(cuid())
  serviceId String?
  name      String
  checklist String[]
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
}

model Project {
  id         String        @id @default(cuid())
  clientId   String
  proposalId String?       @unique
  name       String
  category   String? // site, landing, cardapio, sistema, template...
  status     ProjectStatus @default(IN_PROGRESS)
  value      Decimal?      @db.Decimal(12, 2)
  cost       Decimal?      @db.Decimal(12, 2)
  dueDate    DateTime?
  deliveredAt DateTime?
  technology String?
  url        String?
  repoUrl    String?
  hosting    String?
  domain     String?
  maintenance Boolean      @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?
  client     Client        @relation(fields: [clientId], references: [id])
  proposal   Proposal?     @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  tasks      ProjectTask[]
  payments   Payment[]

  @@index([status, dueDate])
  @@index([clientId])
}

model ProjectTask {
  id        String    @id @default(cuid())
  projectId String
  title     String
  done      Boolean   @default(false)
  position  Int       @default(0)
  doneAt    DateTime?
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
}

// ───────── Financeiro ─────────
model Payment {
  id         String        @id @default(cuid())
  clientId   String?
  projectId  String?
  subscriptionId String?
  category   String // site, landing, sistema, cardapio, manutencao, hospedagem, outros
  description String?
  amount     Decimal       @db.Decimal(12, 2)
  status     PaymentStatus @default(PENDING)
  dueDate    DateTime
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?
  client     Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project    Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([status, dueDate])
  @@index([paidAt])
}

model Expense {
  id        String    @id @default(cuid())
  category  String // hospedagem, dominio, api, ferramenta, servico, operacional
  description String
  amount    Decimal   @db.Decimal(12, 2)
  incurredAt DateTime
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([incurredAt])
}

model Subscription {
  id        String    @id @default(cuid())
  clientId  String
  name      String
  amount    Decimal   @db.Decimal(12, 2)
  dayOfMonth Int
  active    Boolean   @default(true)
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  client    Client    @relation(fields: [clientId], references: [id])
  payments  Payment[]

  @@index([clientId, active])
}

// ───────── Automação, documentos ─────────
model Automation {
  id         String   @id @default(cuid())
  name       String
  trigger    String // lead.no_reply, proposal.accepted, payment.overdue...
  conditions Json     @default("[]")
  actions    Json     @default("[]")
  mode       AutomationMode @default(MANUAL)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  runs       AutomationRun[]
}

model AutomationRun {
  id           String    @id @default(cuid())
  automationId String
  status       JobStatus @default(PENDING)
  input        Json?
  error        String?
  createdAt    DateTime  @default(now())
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, createdAt])
}

model Document {
  id        String   @id @default(cuid())
  clientId  String?
  name      String
  storageKey String // chave no object storage privado
  mime      String
  sizeBytes Int
  createdAt DateTime @default(now())
  deletedAt DateTime?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId])
}
