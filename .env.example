# Copie para .env e preencha. NUNCA commite o .env.
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/carvex?schema=public

# Segredos (gere com: openssl rand -hex 32)
# Chave AES-256-GCM (32 bytes em hex) para criptografar segredos no banco (MFA, credenciais)
DATA_ENCRYPTION_KEY=
# Segredo para HMAC de tokens/CSRF/IP hash
APP_SECRET=

# Sessão
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60

# Redis (filas/rate limit distribuído — fase de jobs)
REDIS_URL=

# Integrações (AGUARDANDO INTEGRAÇÃO — todas opcionais)
GOOGLE_PLACES_API_KEY=
LLM_API_KEY=
WHATSAPP_CLOUD_TOKEN=
SMTP_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
