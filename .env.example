# Copie para .env e preencha. NUNCA commite o .env.
NODE_ENV=production
# Domínio público (sem https://) para o HTTPS automático, e a URL completa:
DOMAIN=crm.seudominio.com.br
APP_URL=https://crm.seudominio.com.br

# Banco (docker-compose monta a URL a partir de POSTGRES_PASSWORD; fora do compose, defina DATABASE_URL)
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/carvex?schema=public

# Segredos — gere cada um com: openssl rand -hex 32
DATA_ENCRYPTION_KEY=   # AES-256-GCM (64 hex). PERDER ESTA CHAVE = perder o 2FA cadastrado
APP_SECRET=
CRON_SECRET=           # autentica GET /api/cron (rotinas agendadas)

# Primeiro acesso (proprietário). Depois do 1º boot você pode apagar OWNER_PASSWORD.
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=        # mín. 12 caracteres, 3 tipos de caractere
# OWNER_RESET=1        # recuperação: redefine a senha com OWNER_PASSWORD no próximo boot (remova depois)

# E-mail para "Esqueci minha senha" (opcional). Formato: smtps://usuario:senha@servidor:465
# Gratuitos: Gmail com "senha de app" (smtps://seuemail%40gmail.com:SENHA_DE_APP@smtp.gmail.com:465) ou Brevo (plano gratuito).
# Sem SMTP_URL o link "Esqueci minha senha" não aparece (use OWNER_RESET).
SMTP_URL=
MAIL_FROM=

# Sessão
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60

# Armazenamento de documentos (use um volume persistente)
DATA_DIR=/data

# IA (opcional). Sem chave funciona o "modo básico" (regras locais, sem custo).
# Chave GRATUITA: Google AI Studio (gemini) em aistudio.google.com/apikey  ou  Groq (groq) em console.groq.com/keys
LLM_PROVIDER=gemini      # gemini | groq | anthropic
LLM_API_KEY=
# LLM_MODEL=             # opcional; padrões: gemini-2.0-flash | llama-3.3-70b-versatile | claude-sonnet-5-5
