# Copie para .env e preencha. NUNCA commite o .env.
NODE_ENV=production
APP_URL=https://seu-dominio.com.br

# Banco (docker-compose monta a URL a partir de POSTGRES_PASSWORD; fora do compose, defina DATABASE_URL)
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/carvex?schema=public

# Segredos — gere cada um com: openssl rand -hex 32
DATA_ENCRYPTION_KEY=   # AES-256-GCM (64 hex). PERDER ESTA CHAVE = perder o 2FA cadastrado
APP_SECRET=
CRON_SECRET=           # autentica GET /api/cron (rotinas agendadas)

# Primeiro acesso (proprietário). Depois do 1º boot você pode apagar OWNER_PASSWORD.
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=        # mín. 12 caracteres, 3 tipos de caractere
# OWNER_RESET=1        # recuperação: redefine a senha com OWNER_PASSWORD no próximo boot (remova depois)

# Sessão
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60

# Armazenamento de documentos (use um volume persistente)
DATA_DIR=/data

# Integrações (opcionais; sem a chave o recurso aparece como AGUARDANDO INTEGRAÇÃO)
GOOGLE_PLACES_API_KEY=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
